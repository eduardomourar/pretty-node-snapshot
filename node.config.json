{
  "$schema": "https://nodejs.org/dist/latest-v24.x/docs/node-config-schema.json",
  "nodeOptions": {
    "disable-warning": [
      "ExperimentalWarning"
    ],
    "experimental-transform-types": true,
    "import": [
      "./src/register.js"
    ]
  },
  "test": {
    "experimental-test-coverage": true,
    "experimental-test-module-mocks": true,
    "test": true,
    "test-coverage-exclude": [
      "**/test/**"
    ],
    "test-reporter": [
      "spec",
      "lcov"
    ],
    "test-reporter-destination": [
      "stdout",
      "coverage/lcov.info"
    ]
  }
}
