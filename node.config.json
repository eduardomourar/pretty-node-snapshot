{
  "nodeOptions": {
    "disable-warning": [
      "ExperimentalWarning"
    ],
    "enable-source-maps": true,
    "import": [
      "amaro/transform",
      "./src/register.js"
    ]
  },
  "test": {
    "experimental-test-coverage": true,
    "experimental-test-module-mocks": true,
    "test": true,
    "test-coverage-exclude": [
      "**/test/**",
      "**/__tests__/**"
    ],
    "test-reporter": [
      "spec",
      "lcov"
    ],
    "test-reporter-destination": [
      "stdout",
      "coverage/lcov.info"
    ]
  }
}
